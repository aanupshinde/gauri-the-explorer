---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getCollection } from 'astro:content';
const stories = (await getCollection('stories')).sort((a, b) => +b.data.date - +a.data.date);
const tags = [...new Set(stories.flatMap((s) => s.data.tags))].sort();
---
<Base title="Stories" description="Travel stories by Gauri the Explorer — mountains, deserts, seas and everything in between.">
  <section class="wrap head">
    <p class="eyebrow">Stories</p>
    <h1>My adventures, one story at a time</h1>
    <p class="lede">Funny moments, amazing places, and lots of tips for young explorers.</p>
  </section>
  <section class="wrap">
    <div class="filters" role="group" aria-label="Filter stories">
      <button class="pill active" data-tag="all">All stories</button>
      {tags.map((t) => <button class="pill" data-tag={t}>{t}</button>)}
    </div>
    <div class="grid">
      {stories.map((s) => <div data-tags={s.data.tags.join('|')}><StoryCard story={s} /></div>)}
    </div>
    <p class="empty muted" hidden>No stories with that tag yet — Gauri is probably writing one!</p>
  </section>
  <div class="section-tight"></div>
</Base>
<style>
  .head { padding-top: clamp(48px, 7vw, 96px); padding-bottom: 24px; }
  .head h1 { max-width: 16ch; }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 40px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 32px; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const items = document.querySelectorAll<HTMLElement>('[data-tags]');
  const empty = document.querySelector<HTMLElement>('.empty');
  const apply = (tag: string) => {
    let shown = 0;
    pills.forEach((p) => p.classList.toggle('active', p.dataset.tag === tag));
    items.forEach((i) => { const on = tag === 'all' || i.dataset.tags!.split('|').includes(tag); i.hidden = !on; if (on) shown++; });
    if (empty) empty.hidden = shown > 0;
    const u = new URL(location.href); tag === 'all' ? u.searchParams.delete('tag') : u.searchParams.set('tag', tag); history.replaceState(null, '', u);
  };
  pills.forEach((p) => p.addEventListener('click', () => apply(p.dataset.tag!)));
  const initial = new URL(location.href).searchParams.get('tag');
  if (initial) apply(initial);
</script>
