---
// Gauri's handwritten-style side note — "Gauri's tip", "Fun fact", etc.
interface Props { title?: string }
const { title = "Gauri's tip" } = Astro.props;
---
<aside class="note">
  <p class="t">{title}</p>
  <div class="b"><slot /></div>
</aside>
<style>
  .note { position: relative; background: #fff4d9; color: #3a2f1a; padding: 22px 26px 18px; margin: 2.2em 0; border-radius: 6px; transform: rotate(-0.8deg); box-shadow: 0 10px 24px -14px rgb(90 60 10 / 0.5); }
  .note::before { content: ''; position: absolute; top: -12px; left: 40px; width: 90px; height: 26px; background: rgb(214 90 60 / 0.35); transform: rotate(-4deg); }
  .t { font-family: var(--font-hand); font-weight: 700; font-size: 1.7rem; color: var(--terracotta); margin: 0 0 4px; line-height: 1; }
  .b { font-family: var(--font-hand); font-size: 1.45rem; line-height: 1.3; }
  .b :global(p:last-child) { margin: 0; }
</style>
