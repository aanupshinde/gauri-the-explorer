---
import { site } from '../data/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar wrap">
    <a href="/" class="logo" aria-label={`${site.name} — home`}>
      <svg viewBox="0 0 40 40" aria-hidden="true" class="mark">
        <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.2" />
        <path d="M20 6 L24 20 L20 34 L16 20 Z" fill="var(--marigold)" />
        <path d="M20 20 L24 20 L20 34 Z" fill="var(--terracotta)" />
        <circle cx="20" cy="20" r="2.4" fill="currentColor" />
      </svg>
      <span class="word">Gauri <em>the</em> Explorer</span>
    </a>
    <nav aria-label="Main">
      <button class="menu-btn" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="sr-only">Menu</span><span class="burger" aria-hidden="true"></span>
      </button>
      <ul id="menu" class="menu" data-menu>
        {site.nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .site-header.overlay { position: fixed; inset: 0 0 auto 0; background: transparent; border-color: transparent; color: var(--on-dark); backdrop-filter: none; }
  .site-header.overlay.scrolled { background: color-mix(in srgb, var(--paper) 92%, transparent); color: var(--ink); border-color: var(--line); backdrop-filter: blur(14px); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; }
  .logo:hover { color: inherit; }
  .mark { width: 36px; height: 36px; transition: transform 0.6s var(--ease); }
  .logo:hover .mark { transform: rotate(35deg); }
  .word { font-family: var(--font-display); font-size: 1.3rem; font-weight: 650; letter-spacing: -0.01em; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .word em { font-family: var(--font-hand); font-style: normal; color: var(--marigold); font-size: 1.15em; font-weight: 700; }
  .menu { display: flex; gap: clamp(14px, 2.4vw, 34px); list-style: none; margin: 0; padding: 0; }
  .menu a { text-decoration: none; font-weight: 600; font-size: 0.95rem; position: relative; padding-block: 6px; }
  .menu a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--marigold); transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease); }
  .menu a:hover, .menu a[aria-current] { color: inherit; }
  .menu a:hover::after, .menu a[aria-current]::after { transform: scaleX(1); }
  .menu-btn { display: none; }

  @media (max-width: 760px) {
    .menu-btn { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: none; color: inherit; cursor: pointer; }
    .burger, .burger::before, .burger::after { display: block; width: 22px; height: 2px; background: currentColor; border-radius: 2px; position: relative; transition: transform 0.3s var(--ease); }
    .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
    .burger::before { top: -7px; } .burger::after { top: 7px; }
    .menu-btn[aria-expanded='true'] .burger { background: transparent; }
    .menu-btn[aria-expanded='true'] .burger::before { transform: translateY(7px) rotate(45deg); }
    .menu-btn[aria-expanded='true'] .burger::after { transform: translateY(-7px) rotate(-45deg); }
    .menu { position: fixed; inset: 72px 0 0 0; flex-direction: column; gap: 0; padding: 24px var(--gutter); background: var(--paper); color: var(--ink); transform: translateX(100%); transition: transform 0.4s var(--ease); }
    .menu.open { transform: none; }
    .menu a { display: block; font-family: var(--font-display); font-size: 2rem; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .menu a::after { display: none; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const btn = document.querySelector('[data-menu-btn]');
  const menu = document.querySelector('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
    header?.classList.toggle('scrolled', open || window.scrollY > 40);
  });
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
