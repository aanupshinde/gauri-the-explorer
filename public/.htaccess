# ---------- Gauri the Explorer — Hostinger (Apache/LiteSpeed) ----------
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Force https + no-www (change if the old site used www — keep whichever Google already indexes)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://gauritheexplorer.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- OLD-SITE REDIRECTS (301 = permanent, passes Google ranking) ----------
# Old WordPress archive URLs (tags, author, feeds, wp-admin) → nearest new page
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^tag/.+$ /blog/ [L,R=301]
RewriteRule ^author/.+$ /about-us/ [L,R=301]
RewriteRule ^(\d{4})/(\d{2})/?$ /blog/ [L,R=301]
RewriteRule ^(\d{4})/?$ /blog/ [L,R=301]
RewriteRule ^feed/?$ /rss.xml [L,R=301]
RewriteRule ^comments/feed/?$ /rss.xml [L,R=301]
RewriteRule ^web-stories/feed/?$ /rss.xml [L,R=301]
RewriteRule ^(.+)/feed/?$ /$1/ [L,R=301]
RewriteRule ^(wp-sitemap|sitemap_index|post-sitemap|page-sitemap|category-sitemap|web-story-sitemap|sitemap)\.xml$ /sitemap-index.xml [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)p=\d+ [OR]
RewriteCond %{QUERY_STRING} (^|&)page_id=\d+
RewriteRule ^$ /? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)s=([^&]+)
RewriteRule ^$ /blog/? [L,R=301]
</IfModule>

# Generated from redirects.txt by scripts/build-redirects.mjs — do not edit between the markers.
# BEGIN REDIRECTS
# END REDIRECTS

# ---------- Speed: compression & caching ----------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "^_astro/">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
